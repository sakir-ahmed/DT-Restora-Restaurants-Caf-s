APP_NAME="DT Restora"
APP_ENV=local
# Demo banner plus a full database rebuild every day at 04:00 Asia/Dhaka.
IS_DEMO=false
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 (Docker service name: mysql)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dt_restora
DB_USERNAME=dt_restora
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@dtrestora.local"
MAIL_FROM_NAME="${APP_NAME}"

# Root administrator (created by the seeder; never commit real values)
ADMIN_NAME="Root Admin"
ADMIN_EMAIL=admin@dtrestora.local
ADMIN_USERNAME=admin
ADMIN_MOBILE=
ADMIN_PASSWORD=

# Reverb (real-time)
REVERB_APP_ID=dt-restora
REVERB_APP_KEY=dt-restora-key
REVERB_APP_SECRET=dt-restora-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# SMS demo: true shows every SMS (including OTP codes) as a toast and sends nothing.
# Local and staging only. It is ignored when APP_ENV=production.
SMS_DEMO=false

# SMS (BdBulkSMS)
BDBULKSMS_URL=https://sms.bdbulksms.net/api/send
BDBULKSMS_TOKEN=

# Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

# Payments
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_BASE_URL=
NAGAD_MODE=manual

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MODE=sandbox

# Cloudflare Turnstile (guest checkout)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Map tiles (Leaflet / OpenStreetMap compatible)
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILES_ATTRIBUTION="OpenStreetMap contributors"

# Backups (local volume by default; S3 optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_STYLE_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
