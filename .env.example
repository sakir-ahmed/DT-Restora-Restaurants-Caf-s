# ---------------------------------------------------------------------------
# DT Restora - production defaults. For local work copy to .env and set
# APP_ENV=local, APP_DEBUG=true and APP_URL to your dev address.
# ---------------------------------------------------------------------------

# Application
APP_NAME="Arman's Kitchen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://restora.example.com
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# Demo mode. Keep false in production. When true the app seeds sample branches,
# menu, staff and orders, shows a demo banner and rebuilds the database daily.
IS_DEMO=false


# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Database (MySQL 8 / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dt_restora
DB_USERNAME=dt_restora
DB_PASSWORD=

# Session (cookies are secure and encrypted outside local development)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

# Cache, queue and Redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real-time (Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=https

# Mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sales@datatechbd.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS (BdBulkSMS). SMS_DEMO is ignored when APP_ENV=production.
SMS_DEMO=false
BDBULKSMS_URL=https://sms.bdbulksms.net/api/send
BDBULKSMS_TOKEN=

# Google sign-in for customers. The button shows only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/customer/auth/google/callback"

# Payments
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_BASE_URL=
NAGAD_MODE=manual

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MODE=live

# Cloudflare Turnstile (guest checkout)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Map tiles (Leaflet / OpenStreetMap compatible)
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILES_ATTRIBUTION="OpenStreetMap contributors"

# Backups (local volume by default; S3 optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Front end
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
