[
  {
    "id": "seg-0-1794336778266",
    "start": 0,
    "end": 2,
    "startLabel": "00:00",
    "endLabel": "00:02",
    "timeLabel": "00:00 - 00:02",
    "text": "মাসে মাত্র এক হাজার টাকায় আপনার"
  },
  {
    "id": "seg-1-1794336778266",
    "start": 2,
    "end": 4,
    "startLabel": "00:02",
    "endLabel": "00:04",
    "timeLabel": "00:02 - 00:04",
    "text": "পুরো রেস্টুরেন্ট এক অ্যাপে!"
  },
  {
    "id": "seg-2-1794336778266",
    "start": 4,
    "end": 6,
    "startLabel": "00:04",
    "endLabel": "00:06",
    "timeLabel": "00:04 - 00:06",
    "text": "বিল করা, টেবিল ধরা,"
  },
  {
    "id": "seg-3-1794336778266",
    "start": 6,
    "end": 8,
    "startLabel": "00:06",
    "endLabel": "00:08",
    "timeLabel": "00:06 - 00:08",
    "text": "পেমেন্ট নেওয়া, সব হয় এক"
  },
  {
    "id": "seg-4-1794336778266",
    "start": 8,
    "end": 10,
    "startLabel": "00:08",
    "endLabel": "00:10",
    "timeLabel": "00:08 - 00:10",
    "text": "স্ক্রিনে। অর্ডার সোজা কিচেনের"
  },
  {
    "id": "seg-5-1794336778266",
    "start": 10,
    "end": 12,
    "startLabel": "00:10",
    "endLabel": "00:12",
    "timeLabel": "00:10 - 00:12",
    "text": "স্ক্রিনে চলে যায়। কোন"
  },
  {
    "id": "seg-6-1794336778266",
    "start": 12,
    "end": 14,
    "startLabel": "00:12",
    "endLabel": "00:14",
    "timeLabel": "00:12 - 00:14",
    "text": "পদে কত খরচ, কোন কাঁচামাল কমে"
  },
  {
    "id": "seg-7-1794336778266",
    "start": 14,
    "end": 16,
    "startLabel": "00:14",
    "endLabel": "00:16",
    "timeLabel": "00:14 - 00:16",
    "text": "আসছে, সব জানা যায়।"
  },
  {
    "id": "seg-8-1794336778266",
    "start": 16,
    "end": 18,
    "startLabel": "00:16",
    "endLabel": "00:18",
    "timeLabel": "00:16 - 00:18",
    "text": "দিনশেষে লাভ কত, রিপোর্টেই"
  },
  {
    "id": "seg-9-1794336778266",
    "start": 18,
    "end": 20,
    "startLabel": "00:18",
    "endLabel": "00:20",
    "timeLabel": "00:18 - 00:20",
    "text": "দেখে নিন। প্রতি ব্রাঞ্চে"
  },
  {
    "id": "seg-10-1794336778266",
    "start": 20,
    "end": 22,
    "startLabel": "00:20",
    "endLabel": "00:22",
    "timeLabel": "00:20 - 00:22",
    "text": "মাসে মাত্র এক হাজার টাকা।"
  },
  {
    "id": "seg-11-1794336778266",
    "start": 22,
    "end": 24,
    "startLabel": "00:22",
    "endLabel": "00:24",
    "timeLabel": "00:22 - 00:24",
    "text": "ইনস্টলেশন একবার, আড়াই"
  },
  {
    "id": "seg-12-1794336778266",
    "start": 24,
    "end": 26,
    "startLabel": "00:24",
    "endLabel": "00:26",
    "timeLabel": "00:24 - 00:26",
    "text": "হাজার টাকা। প্রথম মাস আর"
  },
  {
    "id": "seg-13-1794336778266",
    "start": 26,
    "end": 28,
    "startLabel": "00:26",
    "endLabel": "00:28",
    "timeLabel": "00:26 - 00:28",
    "text": "ট্রেনিং একদম ফ্রি। স্ক্রিনের"
  },
  {
    "id": "seg-14-1794336778266",
    "start": 28,
    "end": 30,
    "startLabel": "00:28",
    "endLabel": "00:30",
    "timeLabel": "00:28 - 00:30",
    "text": "লিংকে গিয়ে ফ্রি ডেমো দেখুন।"
  },
  {
    "id": "seg-15-1794336778266",
    "start": 30,
    "end": 32,
    "startLabel": "00:30",
    "endLabel": "00:32",
    "timeLabel": "00:30 - 00:32",
    "text": "কল বা হোয়াটসঅ্যাপ করুন"
  },
  {
    "id": "seg-16-1794336778266",
    "start": 32,
    "end": 33.8,
    "startLabel": "00:32",
    "endLabel": "00:34",
    "timeLabel": "00:32 - 00:34",
    "text": "০১৫৭৫-৮৮৮৭৭৫ নম্বরে।"
  }
]