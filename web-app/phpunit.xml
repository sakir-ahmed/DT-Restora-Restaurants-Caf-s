<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="IS_DEMO" value="false"/>
        <env name="BRAND_CUSTOMER_PATH" value="storage/framework/testing/no-customer"/>
        <env name="BRAND_CUSTOMER_IMAGES" value="storage/framework/testing/no-customer-images"/>
        <env name="BRAND_NAME" value=""/>
        <env name="BRAND_NAME_BN" value=""/>
        <env name="BRAND_MARK_SHAPE" value=""/>
        <env name="BRAND_THEME_COLOR" value=""/>
        <env name="BRAND_BACKGROUND_COLOR" value=""/>
        <env name="BRAND_BACKGROUND" value=""/>
        <env name="BRAND_SURFACE" value=""/>
        <env name="BRAND_FOREGROUND" value=""/>
        <env name="BRAND_MUTED" value=""/>
        <env name="BRAND_BORDER" value=""/>
        <env name="BRAND_PRIMARY" value=""/>
        <env name="BRAND_PRIMARY_FOREGROUND" value=""/>
        <env name="BRAND_ACCENT" value=""/>
        <env name="BRAND_ACCENT_FOREGROUND" value=""/>
        <env name="BRAND_DARK_BACKGROUND" value=""/>
        <env name="BRAND_DARK_SURFACE" value=""/>
        <env name="BRAND_DARK_FOREGROUND" value=""/>
        <env name="BRAND_DARK_MUTED" value=""/>
        <env name="BRAND_DARK_BORDER" value=""/>
        <env name="BRAND_DARK_PRIMARY" value=""/>
        <env name="BRAND_DARK_PRIMARY_FOREGROUND" value=""/>
        <env name="BRAND_DARK_ACCENT" value=""/>
        <env name="BRAND_DARK_ACCENT_FOREGROUND" value=""/>
        <env name="SMS_DEMO" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
